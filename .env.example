# GBrain MCP Server URL
NEXT_PUBLIC_GBRAIN_URL=http://localhost:8788
GBRAIN_URL=http://localhost:8788

# RealGPT/OpenAI-compatible endpoint used by local GBrain chat and embeddings.
OPENAI_BASE_URL=https://devops.realtek.com/realgpt-api/openai-compatible/v1
# Keep this empty in the example; put the actual local-only key in .env.
OPENAI_API_KEY=

# GBrain API Token（兜底 token，前端未设置时使用）
# 获取方式：gbrain auth create "gbrain-web" --takes-holders world
GBRAIN_TOKEN=
